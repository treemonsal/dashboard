{
  "name": "dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "types": "wrangler types src/server/worker-configuration.d.ts",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "check": "tsc -p tsconfig.client.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply dashboard --local",
    "db:migrate:remote": "wrangler d1 migrations apply dashboard --remote",
    "db:seed:local": "node scripts/seed.mjs --local",
    "db:seed:remote": "node scripts/seed.mjs --remote",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.107.1",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
